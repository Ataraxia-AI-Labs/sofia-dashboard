# ============================================
# SOFIA DASHBOARD — Variables de Entorno
# ============================================
# Copia este archivo como .env.local y llena los valores

# Supabase (mismo proyecto que el backend)
NEXT_PUBLIC_SUPABASE_URL=          # [REQUIRED] Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # [REQUIRED] Supabase anon key (public, NOT service_role)

# URL del backend FastAPI en Render
NEXT_PUBLIC_API_URL=               # [REQUIRED] Backend URL (e.g. https://ataraxia-api-core.onrender.com)

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=            # Sentry DSN for dashboard

# Cloudflare Turnstile (onboarding CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=    # Turnstile site key (public)

# Meta Embedded Signup (WhatsApp)
NEXT_PUBLIC_FB_CONFIG_ID=          # Facebook Login config ID (Meta Embedded Signup)
